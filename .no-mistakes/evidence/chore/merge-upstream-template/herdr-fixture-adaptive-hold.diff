diff --git a/tests/fm-backend-herdr-presentation-e2e.test.sh b/tests/fm-backend-herdr-presentation-e2e.test.sh
index ab1d548c..de63209f 100755
--- a/tests/fm-backend-herdr-presentation-e2e.test.sh
+++ b/tests/fm-backend-herdr-presentation-e2e.test.sh
@@ -1376,15 +1376,20 @@ PATH="$HERDR_ORIGINAL_PATH" "$HERDR_LAB_HELPER" stop "$HERDR_LAB_SESSION" >/dev/
 PATH="$HERDR_ORIGINAL_PATH" "$HERDR_LAB_HELPER" provision "$HERDR_LAB_SESSION" \
   || fail "could not reprovision the isolated session for resume lock-refuse"
 
+# The bounded default is 300 contended attempts, not a wall-clock budget, and
+# each attempt's owner probe costs real time (about 80s in total on a macOS
+# host), so a fixed-duration hold can still end inside it. Hold the lock until
+# the resume under test has returned instead, with a generous safety cap.
 LOCK_REFUSE_READY="$TMP_ROOT/lock-refuse-ready"
-LOCK_REFUSE_HOLD_SECONDS=60
+LOCK_REFUSE_RELEASE="$TMP_ROOT/lock-refuse-release"
+LOCK_REFUSE_HOLD_CAP_SECONDS=600
 LOCK_REFUSE_PATH=$(session_presentation_lock_path) \
   || fail "could not resolve session lock for resume lock-refuse"
-ROOT="$ROOT" READY="$LOCK_REFUSE_READY" HOLD="$LOCK_REFUSE_HOLD_SECONDS" LOCK="$LOCK_REFUSE_PATH" bash -c '
+ROOT="$ROOT" READY="$LOCK_REFUSE_READY" RELEASE="$LOCK_REFUSE_RELEASE" CAP="$LOCK_REFUSE_HOLD_CAP_SECONDS" LOCK="$LOCK_REFUSE_PATH" bash -c '
   . "$ROOT/bin/fm-wake-lib.sh"
   fm_lock_try_acquire "$LOCK" || exit 1
   : > "$READY"
-  sleep "$HOLD"
+  while [ ! -e "$RELEASE" ] && [ "$SECONDS" -lt "$CAP" ]; do sleep 0.2; done
   fm_lock_release "$LOCK"
 ' &
 LOCK_REFUSE_HOLDER_PID=$!
@@ -1392,12 +1397,15 @@ while [ ! -e "$LOCK_REFUSE_READY" ] && kill -0 "$LOCK_REFUSE_HOLDER_PID" 2>/dev/
 [ -e "$LOCK_REFUSE_READY" ] || fail "could not hold the session presentation lock for resume lock-refuse"
 
 LOCK_REFUSE_FOCUS=$(focus_snapshot)
+LOCK_REFUSE_START=$(date +%s)
 if spawn_task "$LOCK_REFUSE_ID" "$HOME_DIR" "$RECOVERY_PROJECT_DIR" \
     > "$TMP_ROOT/lock-refuse-resume.out" 2> "$TMP_ROOT/lock-refuse-resume.err"; then
   LOCK_REFUSE_STATUS=0
 else
   LOCK_REFUSE_STATUS=$?
 fi
+LOCK_REFUSE_ELAPSED=$(( $(date +%s) - LOCK_REFUSE_START ))
+: > "$LOCK_REFUSE_RELEASE"
 if [ "$LOCK_REFUSE_STATUS" -eq 0 ]; then
   kill "$LOCK_REFUSE_HOLDER_PID" 2>/dev/null || true
   wait "$LOCK_REFUSE_HOLDER_PID" 2>/dev/null || true
@@ -1415,6 +1423,7 @@ grep -F "refusing a concurrent resume" "$TMP_ROOT/lock-refuse-resume.err" >/dev/
 assert_focus_is "$LOCK_REFUSE_FOCUS" "resume lock-refuse"
 # Leave the journal/meta in place so the opt-in wait path below can resume the
 # same identity after another stop/reprovision cycle.
+printf '# default resume refused after %ss of bounded contention\n' "$LOCK_REFUSE_ELAPSED"
 pass "real Herdr lab: default resumed identity refuses session lock contention"
 
 # With --herdr-resume-lock-wait, the same exact resume WAITS for session lock
@@ -1433,7 +1442,11 @@ PATH="$HERDR_ORIGINAL_PATH" "$HERDR_LAB_HELPER" provision "$HERDR_LAB_SESSION" \
   || fail "could not reprovision the isolated session for resume lock-wait"
 
 LOCK_WAIT_READY="$TMP_ROOT/lock-wait-ready"
-LOCK_WAIT_HOLD_SECONDS=60
+# Outlast the bounded default as this host just measured it: the refused
+# resume above spent its whole bounded window, so holding 30s beyond that (and
+# never under 60s) shows the opt-in waited past where the default gives up.
+LOCK_WAIT_HOLD_SECONDS=$((LOCK_REFUSE_ELAPSED + 30))
+[ "$LOCK_WAIT_HOLD_SECONDS" -ge 60 ] || LOCK_WAIT_HOLD_SECONDS=60
 LOCK_WAIT_PATH=$(session_presentation_lock_path) \
   || fail "could not resolve session lock for resume lock-wait"
 ROOT="$ROOT" READY="$LOCK_WAIT_READY" HOLD="$LOCK_WAIT_HOLD_SECONDS" LOCK="$LOCK_WAIT_PATH" bash -c '
@@ -1481,6 +1494,7 @@ teardown_task "$LOCK_WAIT_ID" "$HOME_DIR" > "$TMP_ROOT/lock-wait-teardown.out" 2
   || fail "resume lock-wait fixture teardown failed: $(cat "$TMP_ROOT/lock-wait-teardown.err")"
 "$REAL_TREEHOUSE" return --force "$LOCK_WAIT_OLD_WT" >/dev/null 2>&1 || true
 "$REAL_TREEHOUSE" return --force "$LOCK_WAIT_NEW_WT" >/dev/null 2>&1 || true
+printf '# opt-in resume waited %ss through a %ss hold\n' "$LOCK_WAIT_ELAPSED" "$LOCK_WAIT_HOLD_SECONDS"
 pass "real Herdr lab: --herdr-resume-lock-wait waits out session lock contention instead of refusing"
 
